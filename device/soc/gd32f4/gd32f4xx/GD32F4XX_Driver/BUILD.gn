import("//drivers/hdf_core/adapter/khdf/liteos_m/hdf.gni")

config("public") {
  include_dirs = [ "include" ]
}

kernel_module("GD32F4XX_Driver") {
  sources = [
    "Src/gd32f4xx_dma.c",
    "Src/gd32f4xx_ctc.c",
    "Src/gd32f4xx_spi.c",
    "Src/gd32f4xx_can.c",
    "Src/gd32f4xx_exmc.c",
    "Src/gd32f4xx_timer.c",
    "Src/gd32f4xx_usart.c",
    "Src/gd32f4xx_wwdgt.c",
    "Src/gd32f4xx_enet.c",
    "Src/gd32f4xx_dci.c",
    "Src/gd32f4xx_crc.c",
    "Src/gd32f4xx_sdio.c",
    "Src/gd32f4xx_tli.c",
    "Src/gd32f4xx_dbg.c",
    "Src/gd32f4xx_fwdgt.c",
    "Src/gd32f4xx_syscfg.c",
    "Src/gd32f4xx_rtc.c",
    "Src/gd32f4xx_ipa.c",
    "Src/gd32f4xx_misc.c",
    "Src/gd32f4xx_dac.c",
    "Src/gd32f4xx_exti.c",
    "Src/gd32f4xx_gpio.c",
    "Src/gd32f4xx_adc.c",
    "Src/gd32f4xx_fmc.c",
    "Src/gd32f4xx_iref.c",
    "Src/gd32f4xx_i2c.c",
    "Src/gd32f4xx_trng.c",
    "Src/gd32f4xx_pmu.c",
    "Src/gd32f4xx_rcu.c",
