config SOC_COMPANY_GD32
    bool

if SOC_COMPANY_GD32
config SOC_COMPANY
    default "gd32f4"  # 指定了要编译的soc名称

rsource "*/Kconfig.liteos_m.soc"
endif # SOC_COMPANY_GD32


menu "GD32F470VI  adapter Enable"
depends on SOC_GD32F470VI

config ETHERNET_ENABLE
    bool "Enable etnernet"
    default n
    help
      Enable the Ethernet feature

config FILE_SYSTEM_TEST
    bool "Enable file systel test"
    default n
    help
      Add a filesystem test function to the main function

endmenu

menu "GD32F470ZI adapter Enable"
depends on SOC_GD32F470ZI

config ETHERNET_ENABLE
    bool "Enable etnernet"
    default n
    help
      Enable the Ethernet feature
      
config FILE_SYSTEM_TEST
    bool "Enable file systel test"
    default n
    help
      Add a filesystem test function to the main function

endmenu